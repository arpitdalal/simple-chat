{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Simple Chat",
  "version": "0.1.0",
  "identifier": "com.arpitdalal.simple-chat",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Simple Chat",
        "width": 1180,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false,
        "skipTaskbar": true,
        "decorations": true,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 16,
          "y": 20
        },
        "backgroundColor": [
          0,
          0,
          0,
          0
        ],
        "windowEffects": {
          "effects": [
            "hudWindow",
            "mica"
          ],
          "state": "followsWindowActiveState"
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "sql": {
      "preload": [
        "sqlite:simple-chat.db"
      ]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFDNjhDRjIwMTU3MDkzNDAKUldSQWszQVZJTTlvckQ1SkZQYzJXMEw0aUxqRVRwLzV1N0Q5bUJyVE5YcXBVTVQycXF3Y1BHRU0K",
      "endpoints": [
        "https://github.com/arpitdalal/simple-chat/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  }
}
