{
  "name": "simple-chat-workspace",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter simple-chat dev",
    "build": "pnpm --filter simple-chat build",
    "preview": "pnpm --filter simple-chat preview",
    "tauri": "pnpm --filter simple-chat tauri",
    "check": "pnpm --filter simple-chat check",
    "tauri:dev": "pnpm --filter simple-chat tauri:dev",
    "tauri:build": "pnpm --filter simple-chat tauri:build",
    "test": "pnpm --filter simple-chat test",
    "test:watch": "pnpm --filter simple-chat test:watch",
    "test:coverage": "pnpm --filter simple-chat test:coverage",
    "test:e2e": "pnpm --filter simple-chat test:e2e",
    "test:ipc": "pnpm --filter simple-chat test:ipc",
    "test:all": "pnpm --filter simple-chat test:all"
  }
}
